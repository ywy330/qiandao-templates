{
  "name": "chiphell",
  "siteurl": "https://www.chiphell.com",
  "sitename": "chiphell 签到",
  "note": "chiphell 官方已下线每日签到插件（dsu_paulsign 等全部返回“插件不存在或已关闭”）。本模板改为每天带 Cookie 访问一次论坛，等效完成“每日登录”，并在执行日志中记录积分与用户组。",
  "interval": 86400,
  "variables": [
    "cookie"
  ],
  "tpl": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.chiphell.com/forum.php",
        "headers": [
          { "name": "Host", "value": "www.chiphell.com" },
          { "name": "Connection", "value": "keep-alive" },
          { "name": "Cache-Control", "value": "max-age=0" },
          { "name": "DNT", "value": "1" },
          { "name": "Upgrade-Insecure-Requests", "value": "1" },
          { "name": "User-Agent", "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36" },
          { "name": "Accept", "value": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8" },
          { "name": "Sec-Ch-Ua", "value": "\"Not_A Brand\";v=\"8\", \"Chromium\";v=\"120\"" },
          { "name": "Sec-Ch-Ua-Mobile", "value": "?0" },
          { "name": "Sec-Ch-Ua-Platform", "value": "\"Windows\"" },
          { "name": "Sec-Fetch-Dest", "value": "document" },
          { "name": "Sec-Fetch-Mode", "value": "navigate" },
          { "name": "Sec-Fetch-Site", "value": "none" },
          { "name": "Sec-Fetch-User", "value": "?1" },
          { "name": "Accept-Encoding", "value": "gzip, deflate, br" },
          { "name": "Accept-Language", "value": "zh-CN,zh;q=0.9" },
          { "name": "Cookie", "value": "{{cookie}}" }
        ],
        "cookies": []
      },
      "rule": {
        "success_asserts": [
          { "re": "action=logout|退出登录", "from": "content" }
        ],
        "failed_asserts": [
          { "re": "567|拦截|Restricted|EdgeOne|需要先登录|访问已被限制|请先登录", "from": "content" }
        ],
        "extract_variables": [
          { "re": "积分[:：]\\s*([\\d,]+)", "from": "content", "name": "jifen" },
          { "re": "用户组[:：]\\s*([^<\\s]+)", "from": "content", "name": "usergroup" }
        ]
      }
    },
    {
      "comment": "生成日志",
      "request": {
        "method": "GET",
        "url": "api://util/string/replace?r=text&t=%E6%AF%8F%E6%97%A5%E7%99%BB%E5%BD%95%E4%BF%9D%E6%B4%BB%E5%AE%8C%E6%88%90%EF%BC%81%E7%A7%AF%E5%88%86%3A%20{{jifen|urlencode}}%2C%20%E7%94%A8%E6%88%B7%E7%BB%84%3A%20{{usergroup|urlencode}}",
        "headers": [],
        "cookies": []
      },
      "rule": {
        "success_asserts": [
          { "re": "200", "from": "status" }
        ],
        "failed_asserts": [],
        "extract_variables": [
          { "re": ".+", "from": "content", "name": "__log__" }
        ]
      }
    }
  ]
}
